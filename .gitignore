# Build artifacts
/target
/dist
**/*.rs.bk

# Cargo.lock IS committed for binary/cdylib crates — uncomment to exclude only
# if this becomes a published library.
# Cargo.lock

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp

# Daemon runtime socket
/tmp/superduper-dsp.sock

# clap-wrapper CMake build outputs
build-wrappers/

# Local NAM reference clone — used during dev to inspect C++ inference,
# not bundled or distributed. Re-clone with:
#   git clone --depth 1 https://github.com/sdatkinson/NeuralAmpModelerCore \
#       tools/nam-reference/NeuralAmpModelerCore
tools/nam-reference/

# Python bytecode (tools/mix-judge)
__pycache__/
*.pyc

# Local scratch (submission drafts, patches)
_work/

# sdsp-mash: personal session configs (absolute local paths, commercial track names) stay on disk, untracked.
# Only example.toml is the shared, placeholder-path example.
tools/sdsp-mash/*.toml
!tools/sdsp-mash/example.toml
!tools/sdsp-mash/Cargo.toml
