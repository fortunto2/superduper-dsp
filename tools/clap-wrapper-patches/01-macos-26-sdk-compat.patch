 class fixedqueue
 {
  public:
+  fixedqueue() = default;
+  // libc++ on macOS 26 SDK refuses to implicitly synth a copy ctor for a
+  // class with atomic members; mark them deleted (the queue isn't
+  // meaningfully copyable anyway) so any host code that accidentally
+  // tries gets a clear diagnostic instead of an obscure SFINAE failure.
+  fixedqueue(const fixedqueue &) = delete;
+  fixedqueue &operator=(const fixedqueue &) = delete;
+  fixedqueue(fixedqueue &&) = delete;
+  fixedqueue &operator=(fixedqueue &&) = delete;
+
